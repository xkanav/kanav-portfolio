---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stalemate · Kanav Nanda">
  <section class="nf">
    <div class="container">
      <p class="section-label">Illegal move</p>
      <h1 class="nf-title">Stalemate<span class="accent">.</span></h1>
      <p class="section-sub">
        This square doesn't exist on the board. The position is drawn;
        let's set the pieces back up.
      </p>
      <a href="/" class="nf-btn mono magnetic">↺ Back to the opening</a>
    </div>
  </section>
</Layout>

<style>
  .nf {
    min-height: 80svh;
    display: flex;
    align-items: center;
  }
  .nf-title {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 11vw, 8rem);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 0.95;
    margin-bottom: 22px;
  }
  .nf-btn {
    display: inline-block;
    margin-top: 10px;
    padding: 15px 28px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
