---
import fs from 'node:fs';
import Layout from '../layouts/Layout.astro';
import GameTimeline from '../components/GameTimeline';
import KnightsTour from '../components/KnightsTour';
import PortraitReveal from '../components/PortraitReveal';
import RevealHeading from '../components/RevealHeading';
import Brilliancies from '../components/Brilliancies';
import BestMoveChallenge from '../components/BestMoveChallenge';
import EvalBar from '../components/EvalBar';
import { profile } from '../data/profile';
import { research } from '../data/research';
import { achievementCategories } from '../data/achievements';
import { skillGroups, certifications } from '../data/skills';

const firstPlaces = achievementCategories
  .flatMap((c) => c.achievements)
  .filter((a) => a.result === '1st Place').length;
const totalPodiums = achievementCategories
  .flatMap((c) => c.achievements)
  .filter((a) => a.annotation === '!!' || a.annotation === '!').length;

// Drop your Gemini-generated portrait at public/kanav-portrait.png
// and it appears here automatically.
const hasPortrait = fs.existsSync(
  new URL('../../public/kanav-portrait.jpg', import.meta.url)
);
// When a second, restyled portrait is added, the reveal uses it as
// the back layer automatically (otherwise it falls back to a
// chartreuse duotone of the main portrait).
const hasPortraitAlt = fs.existsSync(
  new URL('../../public/kanav-portrait-alt.jpg', import.meta.url)
);

const nameLines = ['KANAV', 'NANDA'];

const ticker = [
  { text: `${firstPlaces} first places`, hot: true },
  { text: 'Ashoka Behavioural Case 3.0 · 1st of 400+' },
  { text: 'MarketCraft · 1st of 125+' },
  { text: 'Grant Thornton · semi-finalist of 900+' },
  { text: 'chess researcher', hot: true },
  { text: '11M+ data points analysed' },
  { text: `${totalPodiums} podiums`, hot: true },
];
---

<Layout>
  <EvalBar client:load />

  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-opening mono" data-reveal>1. e4 · the game begins</p>
        <div class="hero-name-wrap" id="hero-name-wrap">
          <h1 class="hero-name" aria-label={profile.name}>
            {nameLines.map((line, li) => (
              <span class="hero-line" aria-hidden="true">
                {line.split('').map((ch, i) => (
                  <span
                    class="hero-ch"
                    style={`animation-delay: ${0.35 + li * 0.28 + i * 0.045}s`}
                  >{ch}</span>
                ))}
              </span>
            ))}
          </h1>
          <span class="hero-name-top" aria-hidden="true">
            {nameLines.map((line) => (
              <span class="hero-line">
                {line.split('').map((ch) => <span class="hn-ch">{ch}</span>)}
              </span>
            ))}
          </span>
        </div>
        <p class="hero-tagline" data-reveal style="--reveal-delay: 0.9s">
          {profile.tagline}
        </p>
        <p class="hero-intro" data-reveal style="--reveal-delay: 1s">
          {profile.intro}
        </p>
        <div class="hero-facts mono" data-reveal style="--reveal-delay: 1.1s">
          <span>{profile.role}</span>
          <span class="dot">·</span>
          <span>{profile.location}</span>
        </div>
      </div>

      <div class="hero-portrait" data-reveal style="--reveal-delay: 0.7s">
        {hasPortrait ? (
          <PortraitReveal
            client:load
            front="/kanav-portrait.jpg"
            back={hasPortraitAlt ? '/kanav-portrait-alt.jpg' : '/kanav-portrait.jpg'}
            backTinted={!hasPortraitAlt}
            alt={`${profile.name}, at the board`}
            caption="move your cursor over me"
          />
        ) : (
          <div class="portrait-frame portrait-placeholder">
            <span class="pp-glyph">♞</span>
            <span class="pp-note mono">portrait incoming</span>
          </div>
        )}
      </div>
    </div>
    <div class="hero-scroll mono" data-reveal style="--reveal-delay: 1.3s">
      <span class="accent">▾</span> scroll to see the scoresheet
    </div>
  </section>

  <!-- ═══════════ TICKER (JS-driven, reacts to scroll speed) ═══════════ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track" id="marquee-track">
      {[0, 1].map(() => (
        <div class="marquee-item">
          {ticker.map((t) => (
            <>
              <span class={t.hot ? 'hot' : ''}>{t.text}</span>
              <span class="star">✦</span>
            </>
          ))}
        </div>
      ))}
    </div>
  </div>

  <script>
    // JS-driven marquee: guaranteed motion, and it speeds up when
    // the visitor scrolls fast (in either direction).
    const track = document.getElementById('marquee-track');
    if (track) {
      let x = 0;
      let lastScroll = window.scrollY;
      let boost = 0;
      let last = performance.now();
      const step = (now: number) => {
        const dt = Math.min(now - last, 50) / 16.7;
        last = now;
        const sy = window.scrollY;
        boost = Math.min(boost + Math.abs(sy - lastScroll) * 0.02, 6);
        lastScroll = sy;
        boost *= 0.94; // decay back to cruise speed
        x -= (0.8 + boost) * dt;
        const half = track.scrollWidth / 2;
        if (half > 0 && -x >= half) x += half;
        track.style.transform = `translateX(${x}px)`;
        requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    // hero-name mask reveal: a chartreuse copy lights up under the cursor
    const nameWrap = document.getElementById('hero-name-wrap');
    const nameTop = nameWrap?.querySelector('.hero-name-top') as HTMLElement | null;
    if (nameWrap && nameTop && window.matchMedia('(pointer: fine)').matches) {
      nameWrap.addEventListener('mousemove', (e) => {
        const r = nameWrap.getBoundingClientRect();
        nameTop.style.setProperty('--mx', `${e.clientX - r.left}px`);
        nameTop.style.setProperty('--my', `${e.clientY - r.top}px`);
        nameWrap.classList.add('active');
      });
      nameWrap.addEventListener('mouseleave', () => nameWrap.classList.remove('active'));
    }
  </script>

  <!-- ═══════════ THE GAME SO FAR ═══════════ -->
  <section id="game">
    <div class="container">
      <p class="section-label" data-reveal>Experience</p>
      <RevealHeading client:visible as="h2" className="section-title" text="The game so far" />
      <p class="section-sub" data-reveal>
        A collection of experiences that have shaped my journey so far.
      </p>
      <GameTimeline client:visible />
    </div>
  </section>

  <!-- ═══════════ RESEARCH / GAMES PLAYED ═══════════ -->
  <section id="research">
    <div class="container">
      <p class="section-label" data-reveal>Projects</p>
      <RevealHeading client:visible as="h2" className="section-title" text="Research & analysis" />
      <p class="section-sub" data-reveal>
        A collection of projects, each shaped by curiosity, iteration and
        continuous learning.
      </p>
      <div class="research-grid">
        {research.map((r, i) => (
          <article class="r-card" data-reveal style={`--reveal-delay: ${(i % 2) * 0.12}s`}>
            <div class="r-stat mono">
              <span class="r-stat-value">{r.stat.value}</span>
              <span class="r-stat-label">{r.stat.label}</span>
            </div>
            <h3 class="r-title">{r.title}</h3>
            <p class="r-guide mono">
              {r.guide ? `${r.guide} · ` : ''}{r.period}
            </p>
            <dl class="r-body">
              <dt class="mono">The position</dt>
              <dd>{r.position}</dd>
              <dt class="mono">The line</dt>
              <dd>{r.line}</dd>
              <dt class="mono">Evaluation</dt>
              <dd class="r-eval">{r.evaluation}</dd>
            </dl>
            <ul class="r-tags mono">
              {r.tech.map((t) => <li>{t}</li>)}
            </ul>
            {r.deck && (
              <a class="r-deck mono" href={r.deck} target="_blank" rel="noopener">
                {r.deck ? `${r.deckLabel ?? 'The deck'} ↗` : ''}
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════ BRILLIANCY ═══════════ -->
  <section id="moves">
    <div class="container">
      <p class="section-label" data-reveal>Annotated</p>
      <RevealHeading client:visible as="h2" className="section-title" text="Brilliant moves" />
      <p class="section-sub" data-reveal>
        {firstPlaces} first places and {totalPodiums} podiums across case,
        finance and entrepreneurship competitions. Click a move for the story
        behind it.
      </p>
      <div data-reveal>
        <Brilliancies client:visible />
      </div>
    </div>
  </section>

  <!-- ═══════════ OFF THE BOARD (interactive) ═══════════ -->
  <section id="board">
    <div class="container">
      <p class="section-label" data-reveal>Play me</p>
      <RevealHeading client:visible as="h2" className="section-title" text="Off the board" />
      <p class="section-sub" data-reveal>
        A resume shows the moves. It never shows the player. Take the knight
        for a tour and find the squares that actually explain me.
      </p>
      <div data-reveal>
        <KnightsTour client:visible />
      </div>
    </div>
  </section>

  <!-- ═══════════ THE ARSENAL ═══════════ -->
  <section id="arsenal">
    <div class="container">
      <p class="section-label" data-reveal>The arsenal</p>
      <RevealHeading client:visible as="h2" className="section-title" text="Pieces I play with" />
      <div class="arsenal-grid">
        {skillGroups.map((g, i) => (
          <div class="a-group" data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
            <h3 class="a-title mono">{g.group}</h3>
            <ul class="a-items">
              {g.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <div class="certs" data-reveal>
        <h3 class="a-title mono">Certifications</h3>
        <ul class="cert-list">
          {certifications.map((c) => (
            <li>
              <span class="cert-name">{c.name}</span>
              <span class="cert-issuer mono">{c.issuer}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════════ YOUR MOVE ═══════════ -->
  <section id="contact" class="contact">
    <div class="container">
      <p class="section-label" data-reveal>Endgame</p>
      <RevealHeading client:visible as="h2" className="contact-title" text="Your move." />
      <p class="section-sub" data-reveal>
        Wherever curiosity leads next, I'm excited to build, learn, and solve
        meaningful problems. And if you're up for it, there's one more section
        below to unlock something.
      </p>
      <div class="contact-links" data-reveal>
        <a href={`mailto:${profile.email}`} class="contact-btn mono magnetic">
          {profile.email}
        </a>
        <a
          href={profile.links.linkedin}
          target="_blank"
          rel="noopener"
          class="contact-btn mono ghost magnetic"
        >
          LinkedIn ↗
        </a>
        <a href={profile.resume} download class="contact-btn mono ghost magnetic">
          Resume ↓
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════ FIND THE BEST MOVE (optional, sits at the very end) ═══════════ -->
  <section id="challenge">
    <div class="container">
      <p class="section-label" data-reveal>One for the road</p>
      <RevealHeading client:visible as="h2" className="section-title" text="Find the best move" />
      <p class="section-sub" data-reveal>
        A little challenge before you go. Play the game below and see if you can
        get a perfect score. You might even unlock a small surprise.
      </p>
      <div data-reveal>
        <BestMoveChallenge client:visible />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── hero ── */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 150px 0 60px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 56px;
    align-items: center;
    width: 100%;
  }
  .hero-opening {
    color: var(--accent);
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin-bottom: 30px;
  }
  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 12vw, 8.8rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.015em;
  }
  .hero-line {
    display: flex;
    justify-content: space-between;
    overflow: hidden;
  }
  /* masked chartreuse copy of the name, revealed under the cursor.
     the wrap shrinks to the widest line so both KANAV / NANDA
     justify to the same width — left AND right edges line up. */
  .hero-name-wrap { position: relative; width: fit-content; }
  .hero-name-top {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 12vw, 8.8rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.015em;
    opacity: 0;
    transition: opacity 0.3s ease;
    -webkit-mask-image: radial-gradient(circle 150px at var(--mx, -999px) var(--my, -999px), #000 0, #000 55%, rgba(0, 0, 0, 0) 100%);
    mask-image: radial-gradient(circle 150px at var(--mx, -999px) var(--my, -999px), #000 0, #000 55%, rgba(0, 0, 0, 0) 100%);
  }
  .hero-name-wrap.active .hero-name-top { opacity: 1; }
  .hero-name-top .hero-line { display: flex; justify-content: space-between; }
  .hero-name-top .hn-ch { display: inline-block; }
  @media (pointer: coarse) {
    .hero-name-top { display: none; }
  }
  .hero-ch {
    display: inline-block;
    transform: translateY(115%);
    animation: hero-rise 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes hero-rise {
    to { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-ch { transform: none; animation: none; }
  }
  .hero-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.8vw, 1.8rem);
    font-weight: 500;
    color: var(--accent);
    margin-top: 30px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .hero-intro {
    max-width: 540px;
    color: var(--ivory-dim);
    margin-top: 22px;
    font-size: 1.05rem;
  }
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .hero-facts .dot { opacity: 0.4; }
  .hero-scroll {
    margin-top: 64px;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
  }

  /* ── portrait ── */
  .portrait-frame {
    position: relative;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    overflow: hidden;
    background: var(--bg-elev);
    transform: rotate(1.6deg);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .portrait-frame:hover { transform: rotate(0deg) scale(1.015); }
  .portrait-frame img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(0.25) contrast(1.06);
  }
  .portrait-frame figcaption {
    position: absolute;
    left: 14px;
    bottom: 12px;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ivory);
    background: rgba(10, 12, 10, 0.72);
    padding: 6px 12px;
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }
  .portrait-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 18px;
    box-shadow: inset 0 0 0 1px rgba(212, 249, 51, 0.18);
    pointer-events: none;
  }
  .portrait-placeholder {
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 14px;
  }
  .pp-glyph {
    font-size: 5rem;
    color: var(--accent);
    opacity: 0.5;
  }
  .pp-note {
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── research cards ── */
  .research-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .r-card {
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 32px 30px;
    transition: border-color 0.25s, transform 0.25s;
  }
  .r-card:hover {
    border-color: rgba(212, 249, 51, 0.45);
    transform: translateY(-4px);
  }
  .r-stat { margin-bottom: 18px; }
  .r-stat-value {
    display: block;
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }
  .r-stat-label {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 8px;
  }
  .r-title {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1.12;
    text-transform: uppercase;
  }
  .r-guide {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 10px 0 18px;
  }
  .r-body dt {
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 14px;
  }
  .r-body dd {
    color: var(--ivory-dim);
    font-size: 0.94rem;
    margin-top: 4px;
  }
  .r-body .r-eval { color: var(--ivory); }
  .r-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }
  .r-deck {
    display: inline-block;
    margin-top: 20px;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid rgba(212, 249, 51, 0.4);
    padding-bottom: 2px;
  }
  .r-deck:hover { border-color: var(--accent); }
  .r-tags li {
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    padding: 4px 11px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ivory-dim);
  }


  /* ── arsenal ── */
  .arsenal-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .a-group {
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 26px 24px;
  }
  .a-title {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .a-items { list-style: none; }
  .a-items li {
    padding: 7px 0;
    font-size: 0.93rem;
    color: var(--ivory-dim);
    border-bottom: 1px solid var(--line);
  }
  .a-items li:last-child { border-bottom: none; }
  .certs { margin-top: 40px; }
  .cert-list { list-style: none; }
  .cert-list li {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .cert-name { font-weight: 600; }
  .cert-issuer {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  /* ── contact ── */
  .contact { padding-bottom: 60px; }
  .contact-title {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 11vw, 8rem);
    font-weight: 700;
    line-height: 0.95;
    text-transform: uppercase;
    margin-bottom: 22px;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }
  .contact-btn {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    padding: 15px 28px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
  }
  .contact-btn.ghost {
    background: transparent;
    color: var(--ivory);
    border: 1px solid var(--line-strong);
    font-weight: 400;
  }
  .contact-btn.ghost:hover { border-color: var(--accent); color: var(--accent); }

  /* ── responsive ── */
  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-portrait { max-width: 380px; }
    .research-grid { grid-template-columns: 1fr; }
    .moves-grid { grid-template-columns: 1fr; gap: 40px; }
    .arsenal-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .arsenal-grid { grid-template-columns: 1fr; }
  }
</style>
